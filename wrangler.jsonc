{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9508c44c-4d28-4093-bb5a-be88ddce0461","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "af7ab8ba68b24cb2ae284558788528c2" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
